+/** Exact feature capability. No Work approvals, task creation, queue, cancellation,
+ * repository administration, publication, or original API bypass is exposed. */
+export function evenDeviceFeaturePath(method: string, rawUrl: string): string | undefined {
+  const prefix = '/api/even-device/app';
+  if (!rawUrl.startsWith(prefix + '/')) return;
+  const target = rawUrl.slice(prefix.length);
+  if (evenDeviceReadPath(method, '/api/even-device/read' + target)) return target;
+  if (target.includes('?') || target.includes('#')) return;
